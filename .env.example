# Redis that keeps every collected event.
REDIS_URL=redis://localhost:6379/0

# Events are deleted automatically this many days after their release time.
# The app shows at most last week, so 15 days is enough.
RETENTION_DAYS=15

# Forex Factory's public weekly export (current week only, no Actual values).
FEED_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# Minutes between feed refreshes. Above 0, the service also runs its jobs in process every 2
# minutes; 0 disables them (call POST /api/v1/jobs/tick from a cron instead).
# The feed blocks clients that download it too often; keep this >= 15.
REFRESH_MINUTES=30

# Requests only crawl day pages back to the Monday this many weeks ago; older days are
# served from storage only. Keeps reader usage bounded.
PAGE_HISTORY_WEEKS=1

# Day-page readers, tried in this order; one without a key is skipped. Pages add Actual values
# and better / worse status. Firecrawl: 1 credit per page (free: 1,000 / month).
PAGE_FETCHERS=firecrawl
FIRECRAWL_API_KEY=

# Time zone that forexfactory.com pages are rendered in for anonymous visitors.
FF_PAGE_TIMEZONE=America/New_York

# Default time zone for the `date` / `time` fields and day boundaries in responses.
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Bearer token for POST /api/v1/jobs/tick and POST /api/v1/refresh. Empty disables both.
JOBS_TOKEN=

# Firebase service account key (whole JSON on one line) for "Actual released" pushes to the
# Whalio app. Empty disables them. Never commit a real key.
FCM_SERVICE_ACCOUNT=
